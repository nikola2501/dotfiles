    "symbolIcon.textForeground": "#cccccc",
    "symbolIcon.colorForeground": "#aaaaaa",
    "symbolIcon.fileForeground": "#cccccc",
    "symbolIcon.folderForeground": "#bebebe",
    "symbolIcon.referenceForeground": "#00bfff",
    "symbolIcon.eventForeground": "#ff0055",
    "symbolIcon.operatorForeground": "#aaaaaa",
