  "tokenColors": [
    {
      "name": "Foreground",
      "scope": ["keyword.operator.class", "constant.other", "source.php.embedded.line"],
      "settings": { "foreground": "#cccccc", "fontStyle": "" }
    },
    {
      "name": "Variable, String Link, Tag Name",
      "scope": [
        "variable",
        "support.other.variable",
        "string.other.link",
        "entity.name.tag",
        "entity.other.attribute-name",
        "meta.tag",
        "declaration.tag"
      ],
      "settings": { "foreground": "#cccccc" }
    },
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#ff0055", "fontStyle": "" }
    },
    {
      "name": "String literal",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#00bfff", "fontStyle": "" }
    },
    {
      "name": "Character literal",
      "scope": "constant.character",
      "settings": { "foreground": "#00bfff" }
    },
    {
      "name": "Escape sequence",
      "scope": "constant.character.escape",
      "settings": { "foreground": "#00ff41", "fontStyle": "bold" }
    },
    {
      "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.parameter",
        "punctuation.section.embedded",
        "keyword.other.unit"
      ],
      "settings": { "foreground": "#00ff41", "fontStyle": "" }
    },
    {
      "name": "Symbols, Inherited Class, Markup Heading",
      "scope": ["constant.other.symbol", "entity.other.inherited-class", "markup.heading"],
      "settings": { "foreground": "#00ff41", "fontStyle": "" }
    },
    {
      "name": "Keyword, Storage",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "entity.name.tag.css"],
      "settings": { "foreground": "#00ff41", "fontStyle": "" }
    },
    {
      "name": "Operator, Punctuation",
      "scope": ["keyword.operator", "punctuation", "constant.other.color"],
      "settings": { "foreground": "#aaaaaa" }
    },
    {
      "name": "Function, Special Method, Block Level",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method",
        "meta.block-level"
      ],
      "settings": { "foreground": "#efefef", "fontStyle": "" }
    },
    {
      "name": "Class, Support, Namespace",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.type.class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": { "foreground": "#dddddd", "fontStyle": "" }
    },
    {
      "name": "JSON keys are strings in Sublime",
      "scope": "support.type.property-name.json",
      "settings": { "foreground": "#00bfff" }
    },
    {
      "name": "Markup raw",
      "scope": ["markup.raw", "markup.raw.inline", "markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#00ff41" }
    },
    {
      "name": "Markup link",
      "scope": "markup.underline.link",
      "settings": { "foreground": "#00bfff", "fontStyle": "underline" }
    },
    {
      "name": "Markup quote",
      "scope": "markup.quote",
      "settings": { "foreground": "#ff0055", "fontStyle": "italic" }
    },
    {
      "name": "Separator",
      "scope": "meta.separator",
      "settings": { "foreground": "#00ff41", "background": "#222222" }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": { "foreground": "#ff2200" }
    },
    {
      "name": "Invalid deprecated",
      "scope": "invalid.deprecated",
      "settings": { "foreground": "#ffdd00" }
    },
    {
      "name": "Diff insertion",
      "scope": ["markup.inserted", "markup.inserted.diff", "meta.diff.header.to-file"],
      "settings": { "foreground": "#00ff41" }
    },
    {
      "name": "Diff deletion",
      "scope": ["markup.deleted", "markup.deleted.diff", "meta.diff.header.from-file"],
      "settings": { "foreground": "#ff2200" }
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "settings": { "foreground": "#00bfff" }
    },
    {
      "name": "Diff range",
      "scope": "meta.diff.range",
      "settings": { "foreground": "#00d4ff", "fontStyle": "italic" }
    }
  ]
}
