    "charts.foreground": "#cccccc",
    "charts.lines": "#6a6a6a",
    "charts.red": "#ff2200",
    "charts.blue": "#00bfff",
    "charts.yellow": "#ffdd00",
    "charts.orange": "#ff0055",
    "charts.green": "#00ff41",
