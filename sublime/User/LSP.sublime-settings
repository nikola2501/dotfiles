// Settings in here override those in "LSP/LSP.sublime-settings".
//
// gopls is configured in LSP-gopls.sublime-settings, not here — that is the file
// the LSP-gopls package reads. Duplicating the config in both places means two
// things to keep in sync, so this file only switches the client on.
{
    "lsp_format_on_save": true,
    "clients": {
        "gopls": {
            "enabled": true
        },
        "ols": {
            "enabled": true,
            "command": ["ols"],
            "selector": "source.odin",
            "schemes": ["file"]
        }
    }
}
