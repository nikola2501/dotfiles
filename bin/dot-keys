#!/usr/bin/env python3
"""dot-keys - cheatsheet for the Sublime Text bindings this repo adds.

Same idea as hx-keys: descriptions are pulled out of the config itself, so
there is one source of truth and nothing to keep in sync.

  Sublime Text  sublime/User/Default.sublime-keymap   // comments + sections
  GitSavvy      the installed .sublime-package        its own view-local keys

Sublime only, on purpose. Neovim already has `<leader>?` (a live fzf picker
over the real keymaps) and Helix has hx-keys; duplicating them here just
gave three places to look instead of one.

Written in Python rather than awk (like hx-keys) because the Sublime keymap
is JSON-with-comments spread over multiple lines, and GitSavvy's keys live
inside a zip.

  dot-keys            write KEYS.md at the repo root, print its path
  dot-keys --path     just print the path
  dot-keys --stdout   write to stdout instead
"""

import json
import os
import re
import sys
import zipfile

# realpath, ne abspath: skripta se poziva kroz symlink u ~/.local/bin, pa bi
# abspath dao ~/.local kao "repo" i nista se ne bi naslo
REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
OUT = os.path.join(REPO, "KEYS.md")

ST_KEYMAP = os.path.join(REPO, "sublime", "User", "Default.sublime-keymap")
ST_SUPPORT = os.path.expanduser("~/Library/Application Support/Sublime Text")
if not os.path.isdir(ST_SUPPORT):
    ST_SUPPORT = os.path.expanduser("~/.config/sublime-text")
ST_PACKAGES = os.path.join(ST_SUPPORT, "Packages")
INSTALLED_PACKAGES = os.path.join(ST_SUPPORT, "Installed Packages")
APP_PACKAGES = "/Applications/Sublime Text.app/Contents/MacOS/Packages"

GITSAVVY = os.path.join(INSTALLED_PACKAGES, "GitSavvy.sublime-package")
GITSAVVY_LINUX = GITSAVVY

# GitSavvy binds the same letter in several of its views; only these matter
# for the PR review flow, and the context setting is what tells them apart.
GS_VIEWS = {
    "git_savvy.diff_view": "GitSavvy diff view (ctrl+shift+d lands here)",
    "git_savvy.inline_diff_view": "GitSavvy inline diff (ctrl+shift+,)",
    "git_savvy.status_view": "GitSavvy status dashboard (ctrl+shift+s)",
}


def strip_jsonc(text):
    text = re.sub(r"^\s*//.*$", "", text, flags=re.M)
    # i trailing komentari, npr. `{ ... },  // opis`. Guard [^"\n]* znaci da
    # se // unutar stringa (npr. "https://x") ne dira, jer posle njega ima
    # zatvarajuci navodnik.
    text = re.sub(r'//[^"\n]*$', "", text, flags=re.M)
    return re.sub(r",(\s*[\]}])", r"\1", text)


def fmt_keys(keys):
    return " then ".join(keys)


def captions():
    """{command: caption} from every .sublime-commands I can find.

    Same lookup keys_help.py does, so KEYS.md and the shift+F1 panel show the
    same text. This is how `pr_diff` gets "PR: diff vs base branch (all
    files)" without writing the description twice.
    """
    found = {}

    def ingest(raw):
        try:
            data = json.loads(strip_jsonc(raw))
        except ValueError:
            return
        for entry in data:
            if not isinstance(entry, dict):
                continue
            command, caption = entry.get("command"), entry.get("caption")
            if command and caption:
                found.setdefault(command, caption)

    user = os.path.join(ST_PACKAGES, "User")
    if os.path.isdir(user):
        for name in sorted(os.listdir(user)):
            if name.endswith(".sublime-commands"):
                try:
                    with open(os.path.join(user, name)) as handle:
                        ingest(handle.read())
                except OSError:
                    pass

    for root in (INSTALLED_PACKAGES, APP_PACKAGES):
        if not os.path.isdir(root):
            continue
        for name in sorted(os.listdir(root)):
            if not name.endswith(".sublime-package"):
                continue
            try:
                with zipfile.ZipFile(os.path.join(root, name)) as archive:
                    for inner in archive.namelist():
                        if inner.endswith(".sublime-commands"):
                            ingest(archive.read(inner).decode("utf-8", "replace"))
            except (OSError, zipfile.BadZipFile):
                pass
    return found


# --- Sublime -------------------------------------------------------------
def parse_sublime(path):
    """[(section, [prose], [(keys, desc, command, args)])] in file order.

    A binding's description comes from a // comment on the binding itself:
    trailing on the same line, or a single line directly above. A multi-line
    comment block above is prose about the whole group, not one binding, so
    it goes in the section intro instead.
    """
    groups = []
    section, prose, binds = "Other", [], []
    pending = []

    def flush():
        if binds or prose:
            groups.append((section, prose, binds))

    buf, depth = None, 0
    for line in open(path):
        stripped = line.strip()
        if buf is None and stripped.startswith("//"):
            text = stripped[2:].strip()
            head = re.match(r"---+\s*(.*?)\s*---+\s*$", text)
            if head:
                flush()
                section, prose, binds, pending = head.group(1), [], [], []
            elif text:
                prose.append(text)
                pending.append(text)
            continue
        if buf is None and not stripped:
            pending = []
            continue
        if buf is None and stripped.startswith("{"):
            buf, depth = "", 0
        if buf is None:
            continue
        buf += line
        depth += line.count("{") - line.count("}")
        if depth > 0:
            continue
        last = buf.rstrip().split("\n")[-1]
        tail = re.search(r"//\s*(.+?)\s*$", last)
        trailing = tail.group(1) if tail else None
        # komentare skloni PRE rstrip(","): inace ostane "{...},  // opis"
        # -> "{...}," i json.loads pada na trailing zapeti
        try:
            entry = json.loads(strip_jsonc(buf).strip().rstrip(","))
        except ValueError:
            buf, pending = None, []
            continue
        above = pending[0] if len(pending) == 1 else None
        binds.append((fmt_keys(entry["keys"]), trailing or above,
                      entry["command"], entry.get("args") or {}))
        buf, pending = None, []
    flush()
    return groups


def parse_gitsavvy():
    """{view label: [(key, command)]} from the installed package."""
    path = GITSAVVY if os.path.exists(GITSAVVY) else GITSAVVY_LINUX
    if not os.path.exists(path):
        return {}
    try:
        with zipfile.ZipFile(path) as archive:
            raw = archive.read("Default.sublime-keymap").decode("utf-8", "replace")
    except (OSError, KeyError, zipfile.BadZipFile):
        return {}

    out = {}
    for match in re.finditer(r"\{[^{]*?\"keys\"\s*:\s*\[(.*?)\].*?\"command\"\s*:\s*\"(\w+)\"(.*?)\n\s*\}",
                             raw, re.S):
        keys, command, rest = match.group(1), match.group(2), match.group(3)
        for setting, label in GS_VIEWS.items():
            if setting in rest:
                key = " ".join(re.findall(r'"([^"]+)"', keys))
                out.setdefault(label, [])
                if (key, command) not in out[label]:
                    out[label].append((key, command))
    return out


def render_command(value):
    if isinstance(value, list):
        return " → ".join(str(v) for v in value)
    return str(value)


def main():
    if "--path" in sys.argv:
        print(OUT)
        return 0

    out = []
    add = out.append

    add("# KEYS — Sublime Text bindings this repo adds")
    add("")
    add("Generated by `bin/dot-keys`. Do not edit by hand: the descriptions are")
    add("pulled from the comments and `desc` fields in the configs themselves, so")
    add("this file cannot drift from what the editors actually do.")
    add("")
    add("Sources:")
    add("")
    for label, path in (("Sublime", ST_KEYMAP), ("GitSavvy", GITSAVVY)):
        mark = "" if os.path.exists(path) else "  (missing)"
        add("- {}: `{}`{}".format(label, path.replace(os.path.expanduser("~"), "~"), mark))
    add("")
    add("How to search this:")
    add("")
    add("- `shift+F1` in Sublime: quick panel over every binding, searchable by")
    add("  key *and* description, and Enter runs the command")
    add("- `F1`: regenerates and opens this file")
    add("- Terminal: `dot-keys | fzf` or just grep this file")
    add("")
    add("Other editors have their own: Neovim `<leader>?`, Helix `<space>i`.")
    add("")

    # Sublime
    add("## Sublime Text")
    add("")
    caps = captions()
    for section, prose, binds in parse_sublime(ST_KEYMAP):
        if not binds:
            continue
        add("### {}".format(section))
        add("")
        for line in prose:
            add("> {}".format(line))
        if prose:
            add("")
        add("| Key | Does | Command |")
        add("| --- | --- | --- |")
        for keys, desc, command, args in binds:
            shown = command
            if args:
                shown += " " + json.dumps(args, ensure_ascii=False)
            label = desc or caps.get(command) or command.replace("_", " ")
            add("| `{}` | {} | `{}` |".format(keys, label, shown))
        add("")

    gs = parse_gitsavvy()
    if gs:
        add("### GitSavvy view-local keys")
        add("")
        add("> These are GitSavvy's own, active only inside its views — this is")
        add("> where `o` opens the real file. `?` inside any of them lists all.")
        add("")
        for label, binds in gs.items():
            add("**{}**".format(label))
            add("")
            add("| Key | Does | Command |")
            add("| --- | --- | --- |")
            for key, command in sorted(binds):
                add("| `{}` | {} | `{}` |".format(
                    key, caps.get(command) or command.replace("_", " "), command))
            add("")

    text = "\n".join(out) + "\n"
    if "--stdout" in sys.argv:
        sys.stdout.write(text)
        return 0
    with open(OUT, "w") as handle:
        handle.write(text)
    print(OUT)
    return 0


if __name__ == "__main__":
    sys.exit(main())
